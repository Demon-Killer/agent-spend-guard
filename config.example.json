{
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "providers": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "type": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "replace-with-your-provider-key",
      "enabled": true
    }
  ],
  "projects": [
    {
      "id": "demo",
      "name": "Demo Project",
      "providerId": "openrouter",
      "dailyBudgetUsd": 1,
      "monthlyBudgetUsd": 10,
      "maxRequestsPerMinute": 30,
      "enabled": true
    }
  ],
  "virtualKeys": [
    {
      "id": "demo-key",
      "projectId": "demo",
      "name": "Demo Virtual Key",
      "key": "asg_demo_local_key",
      "enabled": true
    }
  ],
  "modelPrices": [
    {
      "model": "default",
      "inputPricePer1MTokens": 1,
      "outputPricePer1MTokens": 3
    }
  ]
}
